# Floating point: mean, variance, and square roots.

def mean(values: list[f64]) -> f64:
    var total = 0.0
    for v in values:
        total += v
    return total / float(len(values))

def stddev(values: list[f64]) -> f64:
    let m = mean(values)
    var squares = 0.0
    for v in values:
        squares += (v - m) * (v - m)
    return sqrt(squares / float(len(values)))

def main():
    let samples = [2.0, 4.0, 4.0, 4.0, 5.0, 5.0, 7.0, 9.0]
    print(mean(samples))
    print(stddev(samples))
    print(round(stddev(samples) * 1000.0))
