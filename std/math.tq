# Standard library: numbers. Import with `import std.math`.

const PI = 3.141592653589793
const TAU = 6.283185307179586
const E = 2.718281828459045
const INT_MAX = 9223372036854775807
const INT_MIN = -9223372036854775808

def clamp(value: i64, low: i64, high: i64) -> i64:
    if value < low:
        return low
    if value > high:
        return high
    return value

def clamp_f(value: f64, low: f64, high: f64) -> f64:
    if value < low:
        return low
    if value > high:
        return high
    return value

def gcd(a: i64, b: i64) -> i64:
    var x = abs(a)
    var y = abs(b)
    while y != 0:
        let t = y
        y = x % y
        x = t
    return x

def lcm(a: i64, b: i64) -> i64:
    if a == 0 or b == 0:
        return 0
    return abs(a // gcd(a, b) * b)

def is_prime(n: i64) -> bool:
    if n < 2:
        return False
    if n % 2 == 0:
        return n == 2
    var d = 3
    while d * d <= n:
        if n % d == 0:
            return False
        d += 2
    return True

def factorial(n: i64) -> Result[i64, str]:
    if n < 0:
        return Err("factorial of a negative number")
    if n > 20:
        return Err("factorial overflows i64 above 20")
    var out = 1
    for i in range(2, n + 1):
        out *= i
    return Ok(out)

def isqrt(n: i64) -> i64:
    assert n >= 0
    var x = int(sqrt(float(n)))
    while x * x > n:
        x -= 1
    while (x + 1) * (x + 1) <= n:
        x += 1
    return x

def lerp(a: f64, b: f64, t: f64) -> f64:
    return a + (b - a) * t

def to_degrees(angle: f64) -> f64:
    return angle * 180.0 / PI

def to_radians(angle: f64) -> f64:
    return angle * PI / 180.0

def mean(values: list[f64]) -> Option[f64]:
    if len(values) == 0:
        return None
    return Some(sum(values) / float(len(values)))
