# Exercises every 0.5 language feature. tests/smoke.sh compares the output with tests/features.expected.

struct Point:
    x: f64
    y: f64

struct Account:
    owner: str
    balance: i64
    history: list[i64]

def distance(a: Point, b: Point) -> f64:
    let dx = a.x - b.x
    let dy = a.y - b.y
    return sqrt(dx * dx + dy * dy)

def deposit(account: Account, amount: i64):
    assert amount > 0
    account.balance += amount
    push(account.history, amount)

def fib(n: i64) -> i64:
    if n < 2:
        return n
    return fib(n - 1) + fib(n - 2)

def word_counts(text: str) -> dict[str, i64]:
    var counts: dict[str, i64] = {}
    for word in split(text, " "):
        if word == "":
            continue
        if word in counts:
            counts[word] += 1
        else:
            counts[word] = 1
    return counts

def first_negative(values: list[i64]) -> i64:
    var i = 0
    while i < len(values):
        if values[i] < 0:
            return i
        i += 1
    return -1

def classify(n: i64) -> str:
    if n < 0:
        return "negative"
    elif n == 0:
        return "zero"
    elif n < 10:
        return "small"
    else:
        return "large"

def main():
    # floats and structs
    let p = Point(0.0, 0.0)
    let q = Point(3.0, 4.0)
    print(distance(p, q))
    print(p)
    print(1.5 + 2.25)
    print(7.0 / 2.0)
    print(float(7) / 2.0)
    print(int(7.9))
    print(round(2.5))
    print(floor(-0.5))
    print(1e3)
    print(-2.5 * 2.0)

    # mutable lists, slicing, for-in, break
    var items = [5, 3, 9, 1]
    push(items, 7)
    sort(items)
    print(items)
    print(items[1:3])
    print(items[:2])
    print(items[3:])
    items[0] = 100
    print(pop(items))
    print(items)
    for value in items:
        if value == 9:
            break
        print(value)
    print(9 in items)
    print(index_of(items, 9))
    reverse(items)
    print(items)

    # list of strings, dicts, structs with containers
    let names = ["cedar", "apple", "birch"]
    sort(names)
    print(join(names, ", "))
    let counts = word_counts("the cat and the dog and the bird")
    print(counts["the"])
    print(counts)
    print(keys(counts))
    print(len(counts))
    print(remove_key(counts, "cat"))
    print("cat" in counts)
    let account = Account("Ada", 10, [])
    deposit(account, 5)
    deposit(account, 20)
    print(account)
    print(account.balance)

    # while loops, elif, recursion, conversions
    print(first_negative([4, 2, -1, 8]))
    print(classify(-3) + " " + classify(0) + " " + classify(4) + " " + classify(40))
    print(fib(20))
    print(str(42) + "!")
    print(int("  -17 "))
    print(float("2.5") * 2.0)

    # strings
    let s = "Hello, World"
    print(len(s))
    print(s[0])
    print(s[7:])
    print(upper(s))
    print(lower(s))
    print(find(s, "World"))
    print(replace(s, "World", "Tacqor"))
    print(starts_with(s, "Hell"))
    print(ends_with(s, "x"))
    print(strip("  padded  ") + "|")
    print("lo" in s)
    print(chr(955))
    print(ord("λ"))
    print("a" < "b")
    print(min(3, 9) + max(3, 9))
    print(min(1.5, 0.5))
    print(abs(-4))
    print(abs(-4.5))
    print(pow(2.0, 10.0))

    # checked arithmetic still works
    print(7 // 2)
    print(-7 // 2)
    print(-7 % 3)
    print(9223372036854775807 - 1 + 1)

    # for-range with start and end, nested loops with continue
    var total = 0
    for i in range(2, 6):
        for j in range(3):
            if j == 1:
                continue
            total += i * j
    print(total)

    # equality on containers and structs
    print([1, 2] == [1, 2])
    print(Point(1.0, 2.0) == Point(1.0, 2.0))
    print({"a": 1} == {"a": 2})

    # parallel sum still deterministic
    print(parallel_sum(1000, 4, fib_small))

def fib_small(n: i64) -> i64:
    return n % 7
